# Public site URL (used for metadata, sitemap, robots, OG).
# If unset, falls back to https://yassine-ben-romdhane.vercel.app
NEXT_PUBLIC_SITE_URL=https://yassine-ben-romdhane.vercel.app

# Contact form (Resend). If RESEND_API_KEY is unset, POST /api/contact
# returns 503 with "Contact email is not configured yet."
RESEND_API_KEY=
# Inbox that receives contact-form messages. Defaults to the owner address
# in src/app/api/contact/route.ts when unset.
CONTACT_EMAIL=
